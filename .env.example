# Copy this file to .env and fill in only the keys you need.
# Kokoro is the default engine and does not require an API key.

# Optional: Google Gemini TTS engines
GOOGLE_API_KEY=your-google-api-key-here

# Optional: Mistral TTS engine
MISTRAL_API_KEY=your-mistral-api-key-here

# Optional: ElevenLabs TTS engine
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Optional: OpenAI TTS engine
OPENAI_API_KEY=your-openai-api-key-here
